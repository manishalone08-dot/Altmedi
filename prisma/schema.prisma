generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  patient
  doctor
  pharmacist
  vendor
  organization
  tenant_admin
  platform_admin
}

enum MappingStatus {
  draft
  approved
  quarantined
  deprecated
}

enum AlternativeClassification {
  same_active_ingredient
  therapeutic_alternative
  not_comparable
}

enum ReviewStatus {
  requested
  in_review
  confirmed
  rejected
  closed
}

enum OfferFreshness {
  fresh
  stale
  expired
}

model Tenant {
  id               String              @id
  name             String
  region           String
  tier             String
  verifiedAt       DateTime
  users            User[]
  vendorOffers     VendorOffer[]
  pharmacistReviews PharmacistReview[]
  auditEvents      AuditEvent[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model User {
  id               String              @id @default(cuid())
  tenantId         String
  name             String
  email            String              @unique
  phone            String?
  passwordHash     String?
  role             UserRole
  licenseNumber    String?
  organization     String?
  speciality       String?
  abhaId           String?
  knownAllergies   String[]
  area             String?
  isVerified       Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  vendorOffers     VendorOffer[]       @relation("VendorOwner")
  pharmacistReviews PharmacistReview[] @relation("ReviewDecider")
  auditEvents      AuditEvent[]        @relation("AuditActor")

  @@index([tenantId, role])
}

model MedicineEntity {
  id                    String               @id
  brandName             String
  genericName           String
  dosageForm            String
  strength              String
  manufacturer          String
  routeOfAdministration String
  packSize              String
  standardMrpInr        Decimal              @db.Decimal(10, 2)
  mappingStatus         MappingStatus        @default(draft)
  isPrescriptionRequired Boolean             @default(true)
  category              String
  ingredients           MedicineIngredient[]
  safetyContent         SafetyContent?
  vendorOffers          VendorOffer[]
  sourceMappings        MedicineMapping[]    @relation("MappingSource")
  targetMappings        MedicineMapping[]    @relation("MappingTarget")
  originalReviews       PharmacistReview[]   @relation("OriginalMedicine")
  alternativeReviews    PharmacistReview[]   @relation("AlternativeMedicine")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model MedicineIngredient {
  id         String         @id @default(cuid())
  medicineId String
  name       String
  strength   String
  unit       String
  medicine   MedicineEntity @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicineId])
}

model MedicineMapping {
  id                 String                    @id
  sourceMedicineId   String
  targetMedicineId   String
  classification     AlternativeClassification
  confidenceScore    Decimal                   @db.Decimal(3, 2)
  clinicalRationale  String                    @db.Text
  status             MappingStatus             @default(draft)
  reviewedBy         String?
  reviewedAt         DateTime?
  sourceMedicine     MedicineEntity            @relation("MappingSource", fields: [sourceMedicineId], references: [id])
  targetMedicine     MedicineEntity            @relation("MappingTarget", fields: [targetMedicineId], references: [id])
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([sourceMedicineId, targetMedicineId])
  @@index([status])
}

model SafetyContent {
  id                 String         @id
  medicineEntityId   String         @unique
  source             String
  sourceUrl          String?
  lastReviewed       DateTime
  reviewer           String
  commonSideEffects  String[]
  seriousWarnings    String[]
  allergyWarnings    String[]
  escalationAdvice   String         @db.Text
  pregnancyCategory  String?
  drivingWarning     String?
  medicine           MedicineEntity @relation(fields: [medicineEntityId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model VendorOffer {
  id               String         @id
  tenantId         String
  vendorId         String?
  vendorName       String
  vendorArea       String
  medicineEntityId String
  priceInr         Decimal        @db.Decimal(10, 2)
  mrpInr           Decimal        @db.Decimal(10, 2)
  packSize         String
  unitPriceInr     Decimal        @db.Decimal(10, 2)
  inStock          Boolean        @default(false)
  stockCount       Int?
  updatedAt        DateTime       @updatedAt
  freshness        OfferFreshness @default(fresh)
  isStale          Boolean        @default(false)
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  vendor           User?          @relation("VendorOwner", fields: [vendorId], references: [id])
  medicine         MedicineEntity @relation(fields: [medicineEntityId], references: [id])

  @@index([tenantId, medicineEntityId])
  @@index([vendorId])
}

model PharmacistReview {
  id                    String         @id
  tenantId              String
  sessionId             String
  patientName           String
  patientPhoneMasked    String
  originalMedicineId    String
  proposedAlternativeId String
  classification        AlternativeClassification
  requestedAt           DateTime       @default(now())
  status                ReviewStatus   @default(requested)
  decisionReason        String?        @db.Text
  assignedPharmacistId  String?
  decidedAt             DateTime?
  urgency               String
  pharmacyName          String
  tenant                Tenant         @relation(fields: [tenantId], references: [id])
  originalMedicine      MedicineEntity @relation("OriginalMedicine", fields: [originalMedicineId], references: [id])
  proposedAlternative   MedicineEntity @relation("AlternativeMedicine", fields: [proposedAlternativeId], references: [id])
  assignedPharmacist    User?          @relation("ReviewDecider", fields: [assignedPharmacistId], references: [id])

  @@index([tenantId, status])
}

model AuditEvent {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  tenantId   String
  actorId    String?
  actor      String
  actorRole  UserRole
  action     String
  entityType String
  entityId   String
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  reason     String?  @db.Text
  sourceIp   String?
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  actorUser  User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([tenantId, timestamp])
  @@index([entityType, entityId])
}
